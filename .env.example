# API kľúče oddelené čiarkou (klient posiela hlavičku "Authorization: Bearer <kľúč>")
# Vygeneruj napr.: python3 -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
API_KEYS=sk-change-me

# Adresa whisper.cpp servera (whisper-cpp.service)
WHISPER_URL=http://127.0.0.1:8081

# Názov modelu vracaný v GET /v1/models
MODEL_NAME=whisper-large-v3-turbo

# Endpoint /v1/audio/translations: auto | true | false
# auto = vypnutý pre "turbo" modely (preklad nepodporujú), inak zapnutý
TRANSLATIONS_ENABLED=auto

# Predvolený jazyk, keď ho klient nepošle ("auto" = detekcia)
DEFAULT_LANGUAGE=sk

# Max. veľkosť uploadu v MB
MAX_UPLOAD_MB=200

# Timeout na prepis v sekundách (CPU + dlhé nahrávky = dlhý čas)
REQUEST_TIMEOUT=1800

# Cesta k ffmpeg
FFMPEG_BIN=ffmpeg

# Úroveň logovania
LOG_LEVEL=info

# --- whisper.cpp (číta whisper-cpp.service) ---
WHISPER_MODEL=/opt/whisper/models/ggml-large-v3-turbo-q5_0.bin
# Počet vlákien – ideálne počet fyzických jadier
WHISPER_THREADS=8
WHISPER_PORT=8081
